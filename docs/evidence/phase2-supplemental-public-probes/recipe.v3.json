  "contractDerivation": {
    "go-usage": {
      "publicContract": "Return per-user total units for events in closed [now-window,now]; units are nonnegative integers; no upper unit or aggregate bound is stated.",
      "READMEsha256": "0cbbaac8a422898b9d9c728aa7bd1ff83a8beaa488afb6e3fb28e0a2ce3a3d4f",
      "inputValues": {
        "unitDecimal": "4611686018427387904",
        "unitPower": "2^62",
        "trueSumDecimal": "9223372036854775808",
        "trueSumPower": "2^63"
      },
      "validity": "Both events qualify at endpoints90 and100. Each unit2^62 and true sum2^63 are exactly representable in binary64, so the probe does not rely on rounding a nonrepresentable JSON input. On linux/arm64 int is64bits; the suspected defect is signed accumulation overflow. Expected output is a positive exact integer, compared using an arbitrary-precision host JSON integer parser."
    },
    "node-config": {
      "publicContract": "Merge objects recursively into a new object, preserve replacement values, and exclude no JSON property names. CLI parses a JSON array argument and serializes an array result.",
      "READMEsha256": "86ed0a69acd96f7cd86c83c9f42017d4913806d83dc31964a1d6dac9d089a385",
      "validity": "Input is literal serialized JSON, not a JavaScript object literal. JSON.parse creates an own __proto__ key. Expected output retains that own key and object value. Ordinary mode:local object is the control.",
      "claimBoundary": "Only own JSON-key loss in the returned serialized object is tested. No global Object.prototype pollution, credential access or exploit-chain claim is made."
    },
    "node-usage": {
      "publicContract": "Return per-user numeric totals for qualifying events; nonnegative integer units and no exclusion for inherited-name user strings. CLI accepts a JSON array and returns corresponding results.",
      "READMEsha256": "8c3df22e8d43c9f3b43391eb430f034018a54999ef9eee81e7781f7b70b600fd",
      "caseOrder": [
        "ordinary own-key addition control a =>5",
        "single qualifying __proto__ user =>own numeric1",
        "single qualifying constructor user =>own numeric1"
      ],
      "validity": "All events lie at closed-window endpoints90 or100 for now100/window10. Units1,2,3 are small exact integers. User strings __proto__ and constructor are literal field values in serialized JSON, not JavaScript object literal syntax. Expected output compares own JSON properties and numeric types.",
      "claimBoundary": "Tests lost/coerced per-user totals only. No global prototype pollution, large-number precision requirement, or cross-trial execution claim."
    }
  },
