{
  "logic.cjs": "exports.solve=function(x){const out=[];const rows=x.windows.filter(([a,b])=>a<b).map(r=>[...r]).sort((a,b)=>a[0]-b[0]||a[1]-b[1]);for(const [a,b] of rows){if(out.length&&a<=out[out.length-1][1])out[out.length-1][1]=Math.max(out[out.length-1][1],b);else out.push([a,b]);}return out;};\n",
  "regression.test.cjs": "const assert=require(\"node:assert/strict\"),{solve}=require(\"./logic.cjs\");assert.deepEqual(solve({\"windows\": [[5, 8], [1, 3], [3, 5], [9, 10]]}),[[1, 8], [9, 10]]);\n"
}
